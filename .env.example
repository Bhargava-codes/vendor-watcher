# Copy this file to .env and fill in the values from your Lovable Cloud project settings.

# Supabase project URL (used server-side and client-side)
SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"

# Supabase publishable key (anon/public key)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

# Supabase project ID
SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Supabase service role key — only used server-side for privileged operations.
# This is not available on Lovable Cloud; Lovable injects it automatically in server functions.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Lovable AI Gateway key — used by the classifier. Lovable injects this automatically
# in the hosted environment; set it locally only if you are running outside Lovable.
LOVABLE_API_KEY="<lovable-api-key>"
